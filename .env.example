# NQR frontend configuration
#
# Identity/hierarchy source. Default (unset or "true") = device-local mock, so
# the prototype runs with no backend. Set to "false" to consume Circle.
VITE_USE_MOCK=true

# Circle API base URL — the system of record for accounts + hierarchy.
# Required only when VITE_USE_MOCK=false. (Endpoints per the proposed contract
# in src/lib/identity/circleProvider.ts.)
VITE_CIRCLE_API_BASE=

# NQR domain backend base URL — concerns, hazards, analytics, sync (our own
# .NET API). Required only when VITE_USE_MOCK=false.
VITE_API_BASE=
