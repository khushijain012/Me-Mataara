# NQR backend configuration

# Postgres connection string. Matches docker-compose.yml defaults.
DATABASE_URL="postgresql://nqr:nqr@localhost:5432/nqr?schema=public"

# HTTP server port
PORT=4000

# JWT signing secret — CHANGE THIS in any real environment.
JWT_SECRET="dev-only-change-me"
# Token lifetime
JWT_EXPIRES_IN="7d"

# Comma-separated list of allowed browser origins (the PWA dev server + preview).
CORS_ORIGINS="http://localhost:5173,http://localhost:4173"
